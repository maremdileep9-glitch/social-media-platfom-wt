<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ConnectHub Social Media</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f0f2f5;
      color: #1c1e21;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      padding: 12px 5%;
      color: white;
      background: #1877f2;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      max-width: 1200px;
      margin: auto;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
      white-space: nowrap;
    }

    .search-box {
      width: 35%;
    }

    .search-box input {
      width: 100%;
      padding: 10px 15px;
      border: none;
      border-radius: 20px;
      outline: none;
      font-size: 14px;
    }

    .profile-small {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: bold;
    }

    .avatar {
      display: flex;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      color: white;
      background: #8b5cf6;
      border-radius: 50%;
      font-weight: bold;
    }

    .layout {
      display: grid;
      grid-template-columns: 240px 1fr 260px;
      gap: 25px;
      width: 94%;
      max-width: 1200px;
      margin: 25px auto;
    }

    .sidebar,
    .rightbar,
    .card,
    .post {
      padding: 20px;
      background: white;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .sidebar {
      height: fit-content;
    }

    .menu-item {
      display: block;
      width: 100%;
      padding: 12px 8px;
      border: none;
      color: #1c1e21;
      background: transparent;
      text-align: left;
      font-size: 16px;
      cursor: pointer;
    }

    .menu-item:hover {
      background: #f0f2f5;
      border-radius: 7px;
    }

    .menu-item.active {
      color: #1877f2;
      font-weight: bold;
    }

    .cover {
      height: 150px;
      background: linear-gradient(135deg, #1877f2, #8b5cf6);
      border-radius: 10px 10px 0 0;
    }

    .profile {
      position: relative;
      padding: 0 20px 20px;
      background: white;
      border-radius: 0 0 10px 10px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .profile .avatar {
      width: 85px;
      height: 85px;
      margin-top: -42px;
      border: 5px solid white;
      font-size: 28px;
    }

    .profile h2 {
      margin: 8px 0 4px;
    }

    .profile p {
      margin: 5px 0;
      color: #65676b;
    }

    .post-form {
      margin-top: 20px;
    }

    textarea {
      width: 100%;
      min-height: 90px;
      padding: 12px;
      border: 1px solid #ccd0d5;
      border-radius: 8px;
      resize: vertical;
      font-family: inherit;
      font-size: 15px;
    }

    .post-actions {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 10px;
    }

    .post-actions button,
    .post button,
    .rightbar button {
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      color: white;
      background: #1877f2;
      cursor: pointer;
      font-weight: bold;
    }

    button:hover {
      opacity: 0.88;
    }

    .post {
      margin-top: 20px;
    }

    .post-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-info h3 {
      margin: 0;
      font-size: 16px;
    }

    .post-time {
      margin-top: 3px;
      color: #65676b;
      font-size: 12px;
    }

    .post-content {
      margin: 18px 0;
      line-height: 1.5;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .post-image {
      width: 100%;
      max-height: 350px;
      margin-bottom: 15px;
      object-fit: cover;
      border-radius: 8px;
    }

    .post-stats {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      color: #65676b;
      font-size: 14px;
      border-bottom: 1px solid #e4e6eb;
    }

    .post-buttons {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 5px;
      padding: 7px 0;
      border-bottom: 1px solid #e4e6eb;
    }

    .post-buttons button {
      color: #65676b;
      background: transparent;
      font-weight: bold;
    }

    .post-buttons button:hover,
    .post-buttons button.liked {
      color: #1877f2;
      background: #e7f3ff;
    }

    .comment-form {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }

    .comment-form input {
      flex: 1;
      padding: 10px;
      border: 1px solid #ccd0d5;
      border-radius: 20px;
      outline: none;
    }

    .comment-form button {
      padding: 8px 13px;
      border: none;
      border-radius: 20px;
      color: white;
      background: #1877f2;
      cursor: pointer;
    }

    .comments {
      margin-top: 10px;
    }

    .comment {
      margin: 6px 0;
      padding: 9px 12px;
      background: #f0f2f5;
      border-radius: 12px;
      font-size: 14px;
    }

    .comment strong {
      margin-right: 5px;
    }

    .delete-button {
      border: none;
      color: #65676b;
      background: transparent;
      cursor: pointer;
      font-size: 18px;
    }

    .rightbar h3 {
      margin-top: 0;
    }

    .suggestion {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin: 15px 0;
    }

    .suggestion-info {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .suggestion button {
      padding: 7px 10px;
      font-size: 12px;
    }

    .empty {
      padding: 25px;
      color: #65676b;
      text-align: center;
      background: white;
      border-radius: 10px;
    }

    #message {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 20;
      display: none;
      padding: 14px 18px;
      color: white;
      background: #16a34a;
      border-radius: 8px;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
    }

    @media (max-width: 950px) {
      .layout {
        grid-template-columns: 180px 1fr;
      }

      .rightbar {
        display: none;
      }

      .search-box {
        width: 40%;
      }
    }

    @media (max-width: 650px) {
      .navbar {
        flex-wrap: wrap;
      }

      .search-box {
        order: 3;
        width: 100%;
      }

      .layout {
        display: block;
        width: 94%;
      }

      .sidebar {
        display: none;
      }

      .profile-small span {
        display: none;
      }
    }
  </style>
</head>

<body>
  <header>
    <nav class="navbar">
      <div class="logo">ConnectHub</div>

      <div class="search-box">
        <input
          type="search"
          id="searchInput"
          placeholder="Search posts..."
          oninput="displayPosts()"
        />
      </div>

      <div class="profile-small">
        <div class="avatar">JD</div>
        <span>John Doe</span>
      </div>
    </nav>
  </header>

  <main class="layout">
    <aside class="sidebar">
      <button class="menu-item active">🏠 Home</button>
      <button class="menu-item">👤 Profile</button>
      <button class="menu-item">👥 Friends</button>
      <button class="menu-item">🔔 Notifications</button>
      <button class="menu-item">💬 Messages</button>
      <button class="menu-item">⚙️ Settings</button>
    </aside>

    <section>
      <div class="cover"></div>

      <div class="profile">
        <div class="avatar">JD</div>
        <h2>John Doe</h2>
        <p>@johndoe</p>
        <p>Web developer | Photographer | Traveler</p>
        <p>📍 New Delhi, India</p>
      </div>

      <div class="card post-form">
        <h3>Create a Post</h3>

        <form id="postForm">
          <textarea
            id="postText"
            placeholder="What is on your mind?"
            required
          ></textarea>

          <div class="post-actions">
            <button type="submit">Publish Post</button>
            <button
              type="button"
              onclick="clearPostForm()"
              style="background: #65676b"
            >
              Clear
            </button>
          </div>
        </form>
      </div>

      <div id="postList"></div>
    </section>

    <aside class="rightbar">
      <h3>People You May Know</h3>

      <div class="suggestion">
        <div class="suggestion-info">
          <div class="avatar">AS</div>
          <span>Anita Shah</span>
        </div>
        <button onclick="followUser(this)">Follow</button>
      </div>

      <div class="suggestion">
        <div class="suggestion-info">
          <div class="avatar" style="background: #14b8a6">
            RK
          </div>
          <span>Rahul Kumar</span>
        </div>
        <button onclick="followUser(this)">Follow</button>
      </div>

      <div class="suggestion">
        <div class="suggestion-info">
          <div class="avatar" style="background: #f97316">
            PM
          </div>
          <span>Priya Menon</span>
        </div>
        <button onclick="followUser(this)">Follow</button>
      </div>
    </aside>
  </main>

  <div id="message"></div>

  <script>
    const defaultPosts = [
      {
        id: 1,
        author: "John Doe",
        initials: "JD",
        content:
          "Just completed my new web development project. Learning HTML, CSS, and JavaScript is exciting!",
        time: "Today at 9:30 AM",
        likes: 12,
        liked: false,
        comments: [
          {
            author: "Anita Shah",
            text: "Congratulations! Great work."
          }
        ]
      },
      {
        id: 2,
        author: "Sarah Williams",
        initials: "SW",
        content:
          "Beautiful sunset during my evening walk. Nature always inspires creativity.",
        time: "Yesterday at 6:15 PM",
        likes: 25,
        liked: false,
        comments: [
          {
            author: "Rahul Kumar",
            text: "Amazing view!"
          }
        ]
      }
    ];

    let posts =
      JSON.parse(localStorage.getItem("socialPosts")) ||
      defaultPosts;

    function savePosts() {
      localStorage.setItem("socialPosts", JSON.stringify(posts));
    }

    function showMessage(message, success = true) {
      const messageBox = document.getElementById("message");

      messageBox.textContent = message;
      messageBox.style.background =
        success ? "#16a34a" : "#dc2626";
      messageBox.style.display = "block";

      setTimeout(() => {
        messageBox.style.display = "none";
      }, 2500);
    }

    function escapeHTML(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function displayPosts() {
      const postList = document.getElementById("postList");
      const searchText = document
        .getElementById("searchInput")
        .value
        .toLowerCase()
        .trim();

      const filteredPosts = posts.filter((post) => {
        return (
          post.content.toLowerCase().includes(searchText) ||
          post.author.toLowerCase().includes(searchText)
        );
      });

      postList.innerHTML = "";

      if (filteredPosts.length === 0) {
        postList.innerHTML = `
          <div class="empty">
            No posts found.
          </div>
        `;
        return;
      }

      filteredPosts.forEach((post) => {
        const postElement = document.createElement("article");
        postElement.className = "post";

        const commentsHTML = post.comments
          .map(
            (comment) => `
              <div class="comment">
                <strong>${escapeHTML(comment.author)}:</strong>
                ${escapeHTML(comment.text)}
              </div>
            `
          )
          .join("");

        postElement.innerHTML = `
          <div class="post-header">
            <div class="user-info">
              <div class="avatar">${escapeHTML(post.initials)}</div>

              <div>
                <h3>${escapeHTML(post.author)}</h3>
                <div class="post-time">
                  ${escapeHTML(post.time)}
                </div>
              </div>
            </div>

            <button
              class="delete-button"
              onclick="deletePost(${post.id})"
              title="Delete post"
            >
              ⋮
            </button>
          </div>

          <div class="post-content">
            ${escapeHTML(post.content)}
          </div>

          <div class="post-stats">
            <span>👍 ${post.likes} likes</span>
            <span>${post.comments.length} comments</span>
          </div>

          <div class="post-buttons">
            <button
              class="${post.liked ? "liked" : ""}"
              onclick="toggleLike(${post.id})"
            >
              👍 Like
            </button>

            <button onclick="focusComment(${post.id})">
              💬 Comment
            </button>

            <button onclick="sharePost(${post.id})">
              ↗ Share
            </button>
          </div>

          <div class="comments">
            ${commentsHTML}
          </div>

          <form
            class="comment-form"
            onsubmit="addComment(event, ${post.id})"
          >
            <input
              type="text"
              id="comment-${post.id}"
              placeholder="Write a comment..."
              required
            />

            <button type="submit">Send</button>
          </form>
        `;

        postList.appendChild(postElement);
      });
    }

    document
      .getElementById("postForm")
      .addEventListener("submit", function (event) {
        event.preventDefault();

        const postText = document
          .getElementById("postText")
          .value.trim();

        if (!postText) {
          showMessage("Please write something first", false);
          return;
        }

        const newPost = {
          id: Date.now(),
          author: "John Doe",
          initials: "JD",
          content: postText,
          time: "Just now",
          likes: 0,
          liked: false,
          comments: []
        };

        posts.unshift(newPost);
        savePosts();
        displayPosts();
        clearPostForm();

        showMessage("Post published successfully");
      });

    function clearPostForm() {
      document.getElementById("postText").value = "";
    }

    function toggleLike(postId) {
      const post = posts.find((item) => item.id === postId);

      if (!post) {
        return;
      }

      post.liked = !post.liked;
      post.likes += post.liked ? 1 : -1;

      savePosts();
      displayPosts();
    }

    function addComment(event, postId) {
      event.preventDefault();

      const input = document.getElementById(
        "comment-" + postId
      );

      const commentText = input.value.trim();

      if (!commentText) {
        return;
      }

      const post = posts.find((item) => item.id === postId);

      if (!post) {
        return;
      }

      post.comments.push({
        author: "John Doe",
        text: commentText
      });

      savePosts();
      displayPosts();

      showMessage("Comment added");
    }

    function focusComment(postId) {
      const input = document.getElementById(
        "comment-" + postId
      );

      if (input) {
        input.focus();
      }
    }

    function sharePost(postId) {
      const post = posts.find((item) => item.id === postId);

      if (!post) {
        return;
      }

      const shareText = post.author + ": " + post.content;

      if (navigator.clipboard) {
        navigator.clipboard.writeText(shareText);
        showMessage("Post copied to clipboard");
      } else {
        showMessage("Post ready to share");
      }
    }

    function deletePost(postId) {
      const confirmed = confirm(
        "Are you sure you want to delete this post?"
      );

      if (!confirmed) {
        return;
      }

      posts = posts.filter((post) => post.id !== postId);
      savePosts();
      displayPosts();

      showMessage("Post deleted");
    }

    function followUser(button) {
      if (button.textContent === "Follow") {
        button.textContent = "Following";
        button.style.background = "#16a34a";
        showMessage("User followed");
      } else {
        button.textContent = "Follow";
        button.style.background = "#1877f2";
        showMessage("User unfollowed");
      }
    }

    displayPosts();
  </script>
</body>
</html>
